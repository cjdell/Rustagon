# Loads the Rustagon flake devShell (see flake.nix) so the IDE, LSPs, and
# shell use the flake's toolchain (esp rustc/cargo shim, rust-analyzer, deno,
# etc.) instead of rustup/homebrew system tools.
#
# `use flake` shells out to the `nix` binary, which is NOT on the minimal PATH
# (e.g. /usr/bin:/bin) that Dock/Finder-launched editors get. Prepend the
# standard install locations first so direnv can always find it.
PATH_add /nix/var/nix/profiles/default/bin
PATH_add /opt/homebrew/bin
use flake
