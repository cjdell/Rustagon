{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "cargofmt": { "disabled": true },
    "prettier": { "disabled": true },
    "rustfmt": {
      "command": ["rustfmt", "--edition", "2021", "--config", "skip_children=true", "$FILE"],
      "extensions": [".rs"]
    },
    "denofmt": {
      "command": ["deno", "fmt", "$FILE"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    }
  }
}
